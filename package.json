{
  "name": "parsonspuzzlesutd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Repo-level scripts. The apps live in frontend/, backend/ and lean-worker/, each with its own package.json.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "doctor": "node scripts/dev.mjs --doctor",
    "setup": "npm ci && npm ci --prefix frontend && npm ci --prefix backend",
    "dev": "npm --prefix frontend run dev --",
    "dev:backend": "npm --prefix backend run dev",
    "dev:lean": "npm --prefix lean-worker start",
    "dev:fullstack": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build --",
    "build:demo": "npm --prefix frontend run build:demo --",
    "dev:demo": "npm --prefix frontend run dev:demo --",
    "preview": "npm --prefix frontend run preview --",
    "lint": "eslint .",
    "test": "npm run test:frontend && npm run test:backend && npm run test:lean && npm run test:scripts",
    "test:frontend": "npm --prefix frontend test --",
    "test:watch": "npm --prefix frontend run test:watch --",
    "test:backend": "npm --prefix backend test",
    "test:lean": "npm --prefix lean-worker test",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0"
  }
}
