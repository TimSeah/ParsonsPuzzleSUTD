{
  "category": "Set Theory",
  "description": "Proofs involving set operations and properties",
  "puzzles": [
    {
      "id": "set1",
      "title": "\\text{Prove: } A \\cap (B \\cup C) = (A \\cap B) \\cup (A \\cap C)",
      "displayTitle": "Prove: Distributive Law for Sets",
      "statement": "A \\cap (B \\cup C) = (A \\cap B) \\cup (A \\cap C)",
      "difficulty": "medium",
      "tags": ["set-theory", "distributive-law", "intersection", "union"],
      "blocks": [
        {
          "id": "set1-1",
          "latex": "\\text{To prove set equality,} \\text{ we show that each side is a subset of the other.}"
        },
        {
          "id": "set1-2",
          "latex": "\\textbf{Part 1: } A \\cap (B \\cup C) {{setop:\\subseteq}} (A \\cap B) \\cup (A \\cap C)"
        },
        {
          "id": "set1-3",
          "latex": "\\text{Let } x {{setop:\\in}} A {{cupcap:\\cap}} (B {{cupcap:\\cup}} C)."
        },
        {
          "id": "set1-4",
          "latex": "\\text{Then } x {{setop:\\in}} A \\text{ and } x {{setop:\\in}} (B \\cup C)."
        },
        {
          "id": "set1-5",
          "latex": "\\text{Since } x {{setop:\\in}} (B {{cupcap:\\cup}} C) \\text{, either } x {{setop:\\in}} B \\text{ or } x {{setop:\\in}} C \\text{ (or both).}"
        },
        {
          "id": "set1-6",
          "latex": "\\text{Case 1: If } x {{setop:\\in}} B \\text{, then since } x {{setop:\\in}} A \\text{, we have } x {{setop:\\in}} A \\cap B."
        },
        {
          "id": "set1-7",
          "latex": "\\text{Case 2: If } x \\in C \\text{, then since } x \\in A \\text{, we have } x \\in A \\cap C."
        },
        {
          "id": "set1-8",
          "latex": "\\text{In either case, } x \\in (A \\cap B) \\cup (A \\cap C)."
        },
        {
          "id": "set1-9",
          "latex": "\\textbf{Part 2: } (A \\cap B) \\cup (A \\cap C) \\subseteq A \\cap (B \\cup C)"
        },
        {
          "id": "set1-10",
          "latex": "\\text{Let } x \\in (A \\cap B) \\cup (A \\cap C)."
        },
        {
          "id": "set1-11",
          "latex": "\\text{Then either } x \\in A \\cap B \\text{ or } x \\in A \\cap C \\text{ (or both).}"
        },
        {
          "id": "set1-12",
          "latex": "\\text{Case 1: If } x \\in A \\cap B \\text{, then } x \\in A \\text{ and } x \\in B \\text{, so } x \\in A \\text{ and } x \\in B \\cup C."
        },
        {
          "id": "set1-13",
          "latex": "\\text{Case 2: If } x \\in A \\cap C \\text{, then } x \\in A \\text{ and } x \\in C \\text{, so } x \\in A \\text{ and } x \\in B \\cup C."
        },
        {
          "id": "set1-14",
          "latex": "\\text{In either case, } x \\in A \\cap (B \\cup C)."
        },
        {
          "id": "set1-15",
          "latex": "\\text{Therefore, } A \\cap (B \\cup C) = (A \\cap B) \\cup (A \\cap C)."
        }
      ],
      "solutionOrder": [
        "set1-1", "set1-2", "set1-3", "set1-4", "set1-5", "set1-6", "set1-7",
        "set1-8", "set1-9", "set1-10", "set1-11", "set1-12", "set1-13", "set1-14", "set1-15"
      ]
    },
    {
      "id": "set2",
      "title": "\\text{Prove: } \\overline{A \\cup B} = \\overline{A} \\cap \\overline{B}",
      "displayTitle": "Prove: De Morgan's Law for Sets",
      "statement": "\\overline{A \\cup B} = \\overline{A} \\cap \\overline{B}",
      "difficulty": "medium",
      "tags": ["set-theory", "de-morgan-law", "complement", "union", "intersection"],
      "blocks": [
        {
          "id": "set2-1",
          "latex": "\\text{To prove set equality,} \\text{ we show that each side is a subset of the other.}"
        },
        {
          "id": "set2-2",
          "latex": "\\textbf{Part 1: } \\overline{A \\cup B} \\subseteq \\overline{A} \\cap \\overline{B}"
        },
        {
          "id": "set2-3",
          "latex": "\\text{Let } x \\in \\overline{A \\cup B}."
        },
        {
          "id": "set2-4",
          "latex": "\\text{Then } x \\notin A \\cup B."
        },
        {
          "id": "set2-5",
          "latex": "\\text{This means } x \\notin A \\text{ and } x \\notin B."
        },
        {
          "id": "set2-6",
          "latex": "\\text{Therefore, } x \\in \\overline{A} \\text{ and } x \\in \\overline{B}."
        },
        {
          "id": "set2-7",
          "latex": "\\text{Hence, } x \\in \\overline{A} \\cap \\overline{B}."
        },
        {
          "id": "set2-8",
          "latex": "\\textbf{Part 2: } \\overline{A} \\cap \\overline{B} \\subseteq \\overline{A \\cup B}"
        },
        {
          "id": "set2-9",
          "latex": "\\text{Let } x \\in \\overline{A} \\cap \\overline{B}."
        },
        {
          "id": "set2-10",
          "latex": "\\text{Then } x \\in \\overline{A} \\text{ and } x \\in \\overline{B}."
        },
        {
          "id": "set2-11",
          "latex": "\\text{This means } x \\notin A \\text{ and } x \\notin B."
        },
        {
          "id": "set2-12",
          "latex": "\\text{Therefore, } x \\notin A \\cup B."
        },
        {
          "id": "set2-13",
          "latex": "\\text{Hence, } x \\in \\overline{A \\cup B}."
        },
        {
          "id": "set2-14",
          "latex": "\\text{Therefore, } \\overline{A \\cup B} = \\overline{A} \\cap \\overline{B}."
        }
      ],
      "solutionOrder": [
        "set2-1", "set2-2", "set2-3", "set2-4", "set2-5", "set2-6", "set2-7",
        "set2-8", "set2-9", "set2-10", "set2-11", "set2-12", "set2-13", "set2-14"
      ]
    },
    {
      "id": "set3",
      "title": "\\text{Prove: } |A \\cup B| = |A| + |B| - |A \\cap B|",
      "displayTitle": "Prove: inclusion–exclusion for two sets",
      "statement": "\\text{For finite sets } A \\text{ and } B \\text{, } |A \\cup B| = |A| + |B| - |A \\cap B|",
      "difficulty": "medium",
      "tags": ["set-theory", "inclusion-exclusion", "cardinality", "combinatorics", "union", "intersection"],
      "blocks": [
        {
          "id": "set3-1",
          "latex": "\\text{First, split } A \\cup B \\text{ into three disjoint parts: } A {{cupcap:\\setminus}} B \\text{, } A {{cupcap:\\cap}} B \\text{ and } B \\setminus A."
        },
        {
          "id": "set3-2",
          "latex": "\\text{Since the parts are disjoint, } |A \\cup B| = |A \\setminus B| + |A \\cap B| + |B \\setminus A|."
        },
        {
          "id": "set3-3",
          "latex": "\\text{Next, each element of } A \\text{ is either in } B \\text{ or not, so } |A| = |A \\setminus B| + |A \\cap B|."
        },
        {
          "id": "set3-4",
          "latex": "\\text{Rearranging, } |A \\setminus B| = |A| - |A \\cap B|."
        },
        {
          "id": "set3-5",
          "latex": "\\text{Similarly, } |B \\setminus A| = |B| - |A \\cap B|."
        },
        {
          "id": "set3-6",
          "latex": "\\text{Substituting: } |A \\cup B| = \\big(|A| - |A \\cap B|\\big) + |A \\cap B| + \\big(|B| - |A \\cap B|\\big)."
        },
        {
          "id": "set3-7",
          "latex": "\\text{Therefore } |A \\cup B| {{op:=}} |A| + |B| - |A \\cap B|."
        }
      ],
      "solutionOrder": ["set3-1", "set3-2", "set3-3", "set3-4", "set3-5", "set3-6", "set3-7"]
    },
    {
      "id": "set4",
      "title": "\\text{Prove: } A \\times (B \\cap C) = (A \\times B) \\cap (A \\times C)",
      "displayTitle": "Prove: Cartesian product distributes over intersection",
      "statement": "A \\times (B \\cap C) = (A \\times B) \\cap (A \\times C)",
      "difficulty": "medium",
      "tags": ["set-theory", "cartesian-product", "intersection"],
      "blocks": [
        {
          "id": "set4-1",
          "latex": "\\text{To prove set equality, we show that each side is a subset of the other.}"
        },
        {
          "id": "set4-2",
          "latex": "\\textbf{Part 1: } A \\times (B \\cap C) \\subseteq (A \\times B) \\cap (A \\times C)"
        },
        {
          "id": "set4-3",
          "latex": "\\text{Let } (x, y) \\in A \\times (B \\cap C) \\text{, so } x \\in A \\text{ and } y {{setop:\\in}} B \\cap C."
        },
        {
          "id": "set4-4",
          "latex": "\\text{Then } y \\in B \\text{ and } y \\in C \\text{, so } (x, y) \\in A \\times B \\text{ and } (x, y) \\in A \\times C."
        },
        {
          "id": "set4-5",
          "latex": "\\text{Hence } (x, y) \\in (A \\times B) {{cupcap:\\cap}} (A \\times C)."
        },
        {
          "id": "set4-6",
          "latex": "\\textbf{Part 2: } (A \\times B) \\cap (A \\times C) \\subseteq A \\times (B \\cap C)"
        },
        {
          "id": "set4-7",
          "latex": "\\text{Let } (x, y) \\in (A \\times B) \\cap (A \\times C) \\text{, so } (x, y) \\in A \\times B \\text{ and } (x, y) \\in A \\times C."
        },
        {
          "id": "set4-8",
          "latex": "\\text{Then } x \\in A \\text{, } y \\in B \\text{ and } y \\in C \\text{, so } y \\in B \\cap C."
        },
        {
          "id": "set4-9",
          "latex": "\\text{Hence } (x, y) \\in A \\times (B \\cap C)."
        },
        {
          "id": "set4-10",
          "latex": "\\text{Both inclusions hold, so } A \\times (B \\cap C) = (A \\times B) \\cap (A \\times C)."
        }
      ],
      "solutionOrder": ["set4-1", "set4-2", "set4-3", "set4-4", "set4-5", "set4-6", "set4-7", "set4-8", "set4-9", "set4-10"]
    }
  ]
}
