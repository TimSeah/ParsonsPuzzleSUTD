# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Educator sign-in: one shared key for creating, editing and reviewing puzzles.
# "educator" works for local development only; production refuses it and any
# key shorter than 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
EDUCATOR_KEY=educator
# Failed sign-in attempts allowed per IP per window
EDUCATOR_AUTH_WINDOW_MS=900000
EDUCATOR_AUTH_MAX_FAILURES=10

# Server-side OpenAI configuration (never prefix secrets with VITE_)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ASSISTANT_NAME=Astra
OPENAI_MODEL=gpt-6-astra
OPENAI_SERVICE_TIER=auto
OPENAI_BACKGROUND=true
OPENAI_TIMEOUT_MS=300000
OPENAI_POLL_INTERVAL_MS=2000

# Lean verification worker
LEAN_VERIFY_URL=http://localhost:3001/verify
# Whole verification request: queue + compile + trusted kernel check (each stage is capped at 30 s)
LEAN_TIMEOUT_MS=90000
OPENAI_REPAIR_ATTEMPTS=2

# Atlas startup and automatic reconnect behavior
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_REQUEST_WAIT_MS=30000
MONGODB_RETRY_MIN_MS=2000
MONGODB_RETRY_MAX_MS=30000
# Optional comma-separated DNS fallback for Atlas SRV lookup failures
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Set when running behind a reverse proxy (number of proxy hops, e.g. 1)
# TRUST_PROXY=1

# AI puzzle generation limits (cached puzzles are not limited)
GENERATION_RATE_LIMIT_WINDOW_MS=900000
GENERATION_RATE_LIMIT_MAX=10
# Fresh generations per UTC day; 0 disables the limit
GENERATION_DAILY_LIMIT_PER_USER=10
GENERATION_DAILY_LIMIT_PER_IP=30
# Fresh generations running at once in this backend process
GENERATION_MAX_CONCURRENT=4

# Student feedback submissions per IP
FEEDBACK_RATE_LIMIT_WINDOW_MS=900000
FEEDBACK_RATE_LIMIT_MAX=5
