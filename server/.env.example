# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Server-side OpenAI configuration (never prefix secrets with VITE_)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ASSISTANT_NAME=Astra
OPENAI_MODEL=gpt-6-astra
OPENAI_SERVICE_TIER=auto
OPENAI_BACKGROUND=true
OPENAI_TIMEOUT_MS=300000
OPENAI_POLL_INTERVAL_MS=2000

# Lean verification worker
LEAN_VERIFY_URL=http://localhost:3001/verify
LEAN_TIMEOUT_MS=30000
OPENAI_REPAIR_ATTEMPTS=2

# Atlas startup and automatic reconnect behavior
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_REQUEST_WAIT_MS=30000
MONGODB_RETRY_MIN_MS=2000
MONGODB_RETRY_MAX_MS=30000
# Optional comma-separated DNS fallback for Atlas SRV lookup failures
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT Secret (if implementing authentication later)
# JWT_SECRET=your-super-secure-jwt-secret-key

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
